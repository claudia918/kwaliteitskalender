{
  "name": "kwaliteitskalender-vo",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "description": "Kwaliteitskalender VO: lokale app in één HTML-bestand, zonder server of netwerk.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/controleer-build.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty",
    "test:e2e": "node scripts/e2e/basis.cjs && node scripts/e2e/sync.cjs && node scripts/e2e-alleen-bestand.mjs && node scripts/e2e-start.mjs && node scripts/e2e-navigatie.mjs && node scripts/e2e-kalender.mjs && node scripts/e2e-export.mjs && node scripts/e2e-rondleiding.mjs",
    "release": "npm run build && node -e \"require('fs').mkdirSync('release',{recursive:true});require('fs').copyFileSync('dist/kwaliteitskalender.html','release/kwaliteitskalender.html')\""
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/wicg-file-system-access": "^2023.10.5",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.3",
    "vite": "^6.4.6",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^2.1.9"
  }
}
